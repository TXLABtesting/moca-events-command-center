# ============================================================================
# MOCA Events Command Center — environment
# Copy to .env(.local) and fill in. Never commit real secrets.
# ============================================================================

# ---- App -------------------------------------------------------------------
# Demo build: seed/fake data + role switcher + credentials login.
# IT build: leave DEMO_MODE unset/false, real SSO only, zero seed data.
NEXT_PUBLIC_DEMO_MODE=true

# ---- Database (Postgres) ---------------------------------------------------
# Local:   postgresql://postgres:postgres@localhost:5432/moca?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/moca?schema=public"

# ---- Auth.js core ----------------------------------------------------------
# Generate: openssl rand -base64 32
AUTH_SECRET="change-me"
# Public URL of the app (used for OAuth callbacks)
AUTH_URL="http://localhost:3000"

# ---- Microsoft Entra ID (Azure AD) SSO -------------------------------------
# App registration → Certificates & secrets / Overview.
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
# https://login.microsoftonline.com/<TENANT_ID>/v2.0
AUTH_MICROSOFT_ENTRA_ID_ISSUER=""

# ---- Generic OAuth 2.0 / OIDC (any other IdP) ------------------------------
OAUTH_NAME="SSO"
OAUTH_ISSUER=""
OAUTH_CLIENT_ID=""
OAUTH_CLIENT_SECRET=""
OAUTH_SCOPE="openid profile email"

# ---- Demo credentials login (demo build only) -----------------------------
# Must be "false"/unset in the IT build so only real SSO is allowed.
AUTH_ALLOW_CREDENTIALS=true
