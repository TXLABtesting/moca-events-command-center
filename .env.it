# IT / production build — Postgres + SSO, zero fake data.
# Usage: cp .env.it .env  (then fill in secrets — see .env.example / README)
NEXT_PUBLIC_DEMO_MODE=false
AUTH_ALLOW_CREDENTIALS=false
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/moca?schema=public"
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_ISSUER=""
OAUTH_NAME="SSO"
OAUTH_ISSUER=""
OAUTH_CLIENT_ID=""
OAUTH_CLIENT_SECRET=""
