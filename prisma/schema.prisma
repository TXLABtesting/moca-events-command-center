// MOCA Events Command Center — Postgres schema (Prisma).
//
// Auth models follow the Auth.js (NextAuth v5) Prisma adapter contract.
// Domain models mirror the dashboard: Events → Teams → Members / Action Items,
// plus Timeline days/blocks and submitted Updates. Bilingual fields are stored
// as *_en / *_ar pairs to match the UI's [en, ar] convention.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- Auth.js ----

enum Role {
  VIEWER // read-only
  MANAGER // Management Access: edit + budget breakdown
  ADMIN // full administration
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(VIEWER)
  accounts      Account[]
  sessions      Session[]
  updates       Update[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------- Domain -----

enum Status {
  GREEN // on track
  AMBER // needs attention
  RED // at risk
}

enum EventState {
  ACTIVE
  BLANK
}

model Event {
  id        String       @id @default(cuid())
  slug      String       @unique // e.g. "wef", "agm", "mbr"
  nameEn    String
  nameAr    String
  periodEn  String?
  periodAr  String?
  logoUrl   String?
  state     EventState   @default(BLANK)
  eventDate DateTime?
  teams     Team[]
  days      TimelineDay[]
  updates   Update[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model Team {
  id          String       @id @default(cuid())
  event       Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId     String
  key         String // stable per-event key, e.g. "d1"
  nameEn      String
  nameAr      String
  status      Status       @default(AMBER)
  progress    Int          @default(0)
  leadName    String?
  leadTitleEn String?
  leadTitleAr String?
  depName     String?
  depTitleEn  String?
  depTitleAr  String?
  updatedLabel String?
  dueLabel    String?
  updatesEn   String[]     @default([])
  updatesAr   String[]     @default([])
  challengesEn String[]    @default([])
  challengesAr String[]    @default([])
  apprItemEn  String?
  apprItemAr  String?
  apprDecEn   String?
  apprDecAr   String?
  apprOwner   String?
  apprDue     String?
  nextActionEn String?
  nextActionAr String?
  nextWho     String?
  nextDue     String?
  order       Int          @default(0)
  members     Member[]
  actions     ActionItem[]

  @@unique([eventId, key])
}

model Member {
  id      String  @id @default(cuid())
  team    Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId  String
  nameEn  String
  nameAr  String
  roleEn  String?
  roleAr  String?
  photo   String? @db.Text // data URI or URL
  order   Int     @default(0)
}

model ActionItem {
  id           String  @id @default(cuid())
  team         Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId       String
  titleEn      String
  titleAr      String
  owner        String?
  status       Status  @default(AMBER)
  priority     String? // "h" | "m" | "l"
  dueLabel     String?
  dependencyEn String?
  dependencyAr String?
  updateEn     String?
  updateAr     String?
  challengeEn  String?
  challengeAr  String?
  nextEn       String?
  nextAr       String?
  order        Int     @default(0)
}

model TimelineDay {
  id       String          @id @default(cuid())
  event    Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId  String
  dateEn   String
  dateAr   String
  dayEn    String
  dayAr    String
  icon     String?
  taglineEn String?
  taglineAr String?
  descEn   String?
  descAr   String?
  order    Int             @default(0)
  blocks   TimelineBlock[]
}

model TimelineBlock {
  id      String      @id @default(cuid())
  day     TimelineDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  dayId   String
  time    String?
  icon    String?
  titleEn String
  titleAr String
  subEn   String?
  subAr   String?
  locEn   String?
  locAr   String?
  teamEn  String?
  teamAr  String?
  notesEn String?
  notesAr String?
  order   Int         @default(0)
}

model Update {
  id         String   @id @default(cuid())
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId    String
  submittedBy User?   @relation(fields: [userId], references: [id])
  userId     String?
  workstream String
  lead       String?
  progress   Int?
  status     String?
  achievements String? @db.Text
  blockers   String?  @db.Text
  risks      String?  @db.Text
  budget     String?  @db.Text
  approvals  String?  @db.Text
  next       String?  @db.Text
  support    String?  @db.Text
  notes      String?  @db.Text
  createdAt  DateTime @default(now())
}
