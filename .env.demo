# Demo build — fake data + role switcher, no backend required.
# Usage: cp .env.demo .env && npm install && npm run dev
NEXT_PUBLIC_DEMO_MODE=true
AUTH_ALLOW_CREDENTIALS=true
AUTH_SECRET="demo-only-not-a-secret-change-in-prod"
AUTH_URL="http://localhost:3000"
# No DATABASE_URL / SSO needed for the demo.
