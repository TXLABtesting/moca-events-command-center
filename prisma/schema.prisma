// MOCA Events Command Center — v7 schema (IT build).
//
// Zero built-in content: every event, team, member, task and timeline entry is a
// row created through the UI. Users are provisioned by email (no passwords —
// identity comes from Microsoft Entra ID / OIDC). Bilingual text is stored as
// *En / *Ar pairs to match the interface's [en, ar] convention.
//
// Provider: PostgreSQL by default. For MySQL run `npm run db:use-mysql` (swaps the
// provider line; the model definitions are portable).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------ Users ----

// The five platform roles. UI keys: admin, inputter (Team), lead, hotel, he.
enum Role {
  ADMIN
  TEAM
  LEAD
  HOTEL
  HE
}

model User {
  id           String           @id @default(cuid())
  email        String           @unique // lower-cased; must match the SSO account email
  name         String?
  role         Role             @default(TEAM)
  active       Boolean          @default(true) // disabled users are refused at sign-in
  lastSignInAt DateTime?
  createdById  String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  assignments  TeamAssignment[]
  auditEntries AuditLog[]
}

// Which teams (streams) a Stream Lead / Team member may see and edit.
model TeamAssignment {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId    String
  createdAt DateTime @default(now())

  @@unique([userId, teamId])
  @@index([teamId])
}

// ----------------------------------------------------------------- Events ----

model Event {
  id           String            @id // generated by the UI when the admin creates the event
  nameEn       String
  nameAr       String
  periodEn     String?
  periodAr     String?
  owner        String?
  logo         String?           @db.Text // data URI or /assets path
  feedbackOpen Boolean           @default(false)
  order        Int               @default(0)
  createdById  String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  teams        Team[]
  days         TimelineDay[]
  feedback     FeedbackEntry[]
  docs         EventDoc[]
}

model Team {
  id            String           @id // generated by the UI
  event         Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId       String
  nameEn        String
  nameAr        String
  status        String           @default("a") // g = on track, a = attention, r = at risk
  progress      Int              @default(0)
  updatedLabel  String?
  dueLabel      String?
  delayed       Boolean          @default(false)
  leadName      String?
  leadTitleEn   String?
  leadTitleAr   String?
  depName       String?
  depTitleEn    String?
  depTitleAr    String?
  updates       Json? // [[en, ar], ...] latest updates shown on the card
  challenges    Json? // [[en, ar], ...]
  apprItemEn    String?
  apprItemAr    String?
  apprDecEn     String?
  apprDecAr     String?
  apprOwner     String?
  apprDue       String?
  nextActionEn  String?
  nextActionAr  String?
  nextWho       String?
  nextDue       String?
  order         Int              @default(0)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  members       Member[]
  tasks         Task[]
  logEntries    TeamLogEntry[]
  nominations   Nomination[]
  assignments   TeamAssignment[]

  @@index([eventId])
}

model Member {
  id        String   @id // generated by the UI
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId    String
  nameEn    String
  nameAr    String
  roleEn    String?
  roleAr    String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teamId])
}

// Workforce changes proposed by Team / Stream Lead users, waiting for an admin decision.
model Nomination {
  id        String   @id // generated by the UI
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId    String
  data      Json // the nomination as submitted (name, role, kind, photo ref, ...)
  createdAt DateTime @default(now())

  @@index([teamId])
}

model Task {
  id           String   @id @default(cuid())
  team         Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId       String
  order        Int // position in the team's task list (the UI addresses tasks by position)
  titleEn      String
  titleAr      String
  owner        String?
  status       String   @default("n") // n not started · p in progress · a attention · g done · r at risk · d delayed
  priority     String   @default("m") // h / m / l
  dueLabel     String?
  dependencyEn String?
  dependencyAr String?
  updateEn     String?
  updateAr     String?
  challengeEn  String?
  challengeAr  String?
  nextEn       String?
  nextAr       String?
  approval     String   @default("nr") // req / nr / pend
  meeting      Json? // { rec, pur, loc, d, tm } when the task includes a meeting
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([teamId, order])
}

// Dated entries submitted from a team page (updates, challenges, approvals, next steps).
model TeamLogEntry {
  id        String   @id // generated by the UI
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId    String
  kind      String // upd / chal / appr / next
  data      Json
  createdAt DateTime @default(now())

  @@index([teamId, kind])
}

model TimelineDay {
  id        String          @id @default(cuid())
  event     Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId   String
  order     Int
  dateEn    String
  dateAr    String
  dayEn     String
  dayAr     String
  icon      String?
  taglineEn String?
  taglineAr String?
  descEn    String?
  descAr    String?
  blocks    TimelineBlock[]

  @@unique([eventId, order])
}

model TimelineBlock {
  id      String      @id @default(cuid())
  day     TimelineDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  dayId   String
  order   Int
  time    String?
  icon    String?
  titleEn String
  titleAr String
  subEn   String?
  subAr   String?
  locEn   String?
  locAr   String?
  teamEn  String?
  teamAr  String?
  notesEn String?
  notesAr String?

  @@unique([dayId, order])
}

// Accommodation record per workforce member (Hotel role / Admin).
model HotelAssignment {
  memberId  String   @id
  data      Json // { hotel, conf, cin, cout, mate, mateApproved, sentWa, sentEm, ... }
  updatedAt DateTime @updatedAt
}

model FeedbackEntry {
  id        String   @id @default(cuid())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId   String
  data      Json // the submitted feedback form
  createdAt DateTime @default(now())

  @@index([eventId])
}

// Employee directory uploaded by an admin (CSV) — used to pick people when adding members.
model DirectoryEntry {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  data      Json? // any extra CSV columns
  createdAt DateTime @default(now())
}

// Photos for leads / deputies / members, keyed exactly as the UI keys them.
model Photo {
  key       String   @id
  dataUrl   String   @db.Text
  updatedAt DateTime @updatedAt
}

// Per-event documents that are inherently document-shaped (approval workflow
// state with comments, design checklist, hidden-item flags, legacy views).
model EventDoc {
  id        String   @id @default(cuid())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId   String
  key       String // approvals / design / basehide / ws_edits / ws_members / ws_order
  doc       Json
  updatedAt DateTime @updatedAt

  @@unique([eventId, key])
}

// Every write, with who did it.
model AuditLog {
  id         String   @id @default(cuid())
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorId    String?
  actorEmail String?
  action     String // state.set / users.create / users.update / users.delete / auth.signin ...
  entityType String?
  entityId   String?
  detail     Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

// Global (event-independent) documents kept for the legacy workstream views.
model GlobalDoc {
  key       String   @id // ws_edits / ws_members / ws_order
  doc       Json
  updatedAt DateTime @updatedAt
}
