# MOCA Events Command Center — IT build (staging / production)
# Usage: cp .env.it .env  → fill the values → never commit .env
# Full explanation of every variable: IT-DEPLOYMENT-GUIDE.md

# ---- Database -----------------------------------------------------------------
# PostgreSQL (default):
DATABASE_URL="postgresql://moca:CHANGE_ME@db:5432/moca_events?schema=public"
# MySQL / MariaDB instead: run `npm run db:use-mysql` once, then use:
# DATABASE_URL="mysql://moca:CHANGE_ME@db:3306/moca_events"

# ---- Application --------------------------------------------------------------
NODE_ENV=production
PORT=3000
# Public URL of the platform (exactly as users open it; used for SSO redirects + cookies)
AUTH_URL="https://events-staging.moca.gov.ae"
# 32+ random characters: openssl rand -base64 32
AUTH_SECRET=""
# Comma-separated email(s) promoted to Admin by `npm run db:seed` (first sign-in bootstrap)
SEED_ADMIN_EMAIL="first.admin@moca.gov.ae"
APP_VERSION=7.0.0

# ---- Sign-in: Microsoft Entra ID (Azure AD) ------------------------------------
# App registration → Overview: Application (client) ID + Directory (tenant) ID
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_ISSUER="https://login.microsoftonline.com/<TENANT_ID>/v2.0"
# Redirect URI to register on the app:  ${AUTH_URL}/api/auth/callback/microsoft-entra-id

# ---- Optional second OIDC provider (leave empty if not used) ---------------------
OAUTH_NAME="SSO"
OAUTH_ISSUER=""
OAUTH_CLIENT_ID=""
OAUTH_CLIENT_SECRET=""
OAUTH_SCOPE="openid profile email"

# ---- Local testing only — NEVER true in production ------------------------------
# Enables an email-only sign-in (no IdP) for provisioned emails.
AUTH_ALLOW_CREDENTIALS=false
